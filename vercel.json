{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/internal/jobs/tick",
      "schedule": "0 0 * * *"
    }
  ],
  "functions": {
    "app/api/internal/jobs/tick/route.ts": {
      "maxDuration": 60
    },
    "app/api/v1/chat/route.ts": {
      "maxDuration": 60
    }
  }
}
